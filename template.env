# Данные для создания и подключения к базам данных
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_root_password
MYSQL_ROOT_PASSWORD=mysql_root_password
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password

# Имена баз данных для каждого сервиса
AUTH_DATABASE=tdn_auth
USERS_DATABASE=tdn_users
CAMPAIGN_DATABASE=tdn_campaign
ACCOUNTS_DATABASE=tdn_accounts
ACCOUNTS_MYSQL_USER=tdn_accounts
ACCOUNTS_MYSQL_PASSWORD=
GAME_SYSTEMS_DATABASE=tdn_game_systems

# OIDC конфигурация
OIDC_ISSUER_URL=http://auth-service:8080
Oidc__Providers__0__Issuer=
Oidc__Providers__0__Audiences__0=
Oidc__Providers__0__ValidHeaderTypes__0=at+jwt
Oidc__Providers__0__AllowHttpForDevelopment=false
Accounts__FirstAccountId=1

# URL'ы сервисов
AUTH_SERVICE_URL=http://auth-service:8080
USERS_SERVICE_URL=http://users-service:8080
CAMPAIGN_SERVICE_URL=http://campaign-service:8080
GAME_SYSTEMS_SERVICE_URL=http://game-systems-service:8080
ACCOUNT_SERVICE_URL=http://account-service:8080
ACCOUNT_SERVICE_KEY=
INTERNAL_SERVICE_KEY=
ACCOUNT_SERVICE_TIMEOUT_SECONDS=10
SYNC_SERVICE_URL=http://sync-service:8090

# Пути к ключам RSA
PRIVATE_KEY_PATH=/certs/private.pem
PUBLIC_KEY_PATH=/certs/public.pem

# Инфраструктура
REDIS_CONNECTION_STRING=redis:6379
ASPNETCORE_URLS="http://0.0.0.0:8080;http://0.0.0.0:8081"

# Gateway
CORS_ENABLED=1
CORS_ORIGINS=*

# Campaign
MONGO_SCHEMAS_DATABASE=tdn-schemas

APP_CONFIG=/app/configs/app.json
