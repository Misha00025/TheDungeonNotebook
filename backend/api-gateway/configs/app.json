{
  "logging": {
    "level": "INFO",
    "file": "/app/logs/gateway.log",
    "format": "%(asctime)s [%(levelname)s] [%(name)s] [sub={jwt.sub}] %(message)s",
    "rotation": {
      "type": "timed",
      "when": "midnight",
      "interval": 1,
      "backup_count": 7
    }
  },
  "request_id": {
    "header": "X-Request-ID",
    "generate_if_missing": true
  }
}
