{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Authentication.OpenIdConnect": "None",
      "Microsoft.IdentityModel": "None"
    }
  },
  "AllowedHosts": "*",
  "Bff": {
    "Endpoints": {
      "Login": "/bff/login",
      "Session": "/bff/session",
      "Logout": "/bff/logout"
    },
    "Redis": {
      "ConnectionString": "localhost:6379,abortConnect=false",
      "KeyPrefix": "tdn:bff:"
    },
    "Session": {
      "Lifetime": "08:00:00",
      "RefreshBeforeExpiry": "00:00:30",
      "AccessTokenLifetimeWhenMissing": "00:05:00",
      "LockWaitTimeout": "00:00:10",
      "LockExpiry": "00:00:30",
      "LockExtensionCadence": "00:00:05"
    },
    "ClientAuthentication": "PostBody",
    "DataProtection": {
      "ApplicationName": "Tdn.Bff"
    },
    "Transport": {
      "RequestHeaders": [
        "Accept",
        "Accept-Language",
        "Content-Type",
        "Content-Length",
        "Content-Encoding",
        "Content-Disposition",
        "If-Match",
        "If-None-Match",
        "If-Modified-Since",
        "If-Unmodified-Since",
        "Range",
        "If-Range",
        "Idempotency-Key",
        "X-Request-Id"
      ],
      "ResponseHeaders": [
        "Content-Type",
        "Content-Length",
        "Content-Encoding",
        "Content-Disposition",
        "Content-Language",
        "ETag",
        "Last-Modified",
        "Location",
        "Retry-After",
        "Vary",
        "Accept-Ranges",
        "Content-Range",
        "Allow",
        "X-Request-Id"
      ]
    }
  },
  "Oidc": {
    "Authority": "http://localhost:8080/realms/tdn-example",
    "ClientId": "tdn-bff",
    "ClientSecret": "",
    "CallbackPath": "/bff/callback",
    "RequireHttpsMetadata": false,
    "ResponseMode": "query",
    "BackchannelTimeout": "00:00:30",
    "Scope": [
      "openid",
      "profile",
      "offline_access"
    ]
  },
  "Cookie": {
    "Cookie": {
      "Name": "tdn-session",
      "HttpOnly": true,
      "SecurePolicy": "SameAsRequest",
      "SameSite": "Lax"
    }
  },
  "Antiforgery": {
    "HeaderName": "X-CSRF-TOKEN",
    "Cookie": {
      "HttpOnly": true,
      "SecurePolicy": "SameAsRequest",
      "SameSite": "Strict"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "gateway": {
        "ClusterId": "gateway",
        "Match": {
          "Path": "/bff/api/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/bff/api"
          }
        ]
      }
    },
    "Clusters": {
      "gateway": {
        "Destinations": {
          "gateway": {
            "Address": "http://localhost:5000/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:40"
        }
      }
    }
  }
}
