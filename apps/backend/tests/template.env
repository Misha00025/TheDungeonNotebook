# Данные для создания и подключения к базам данных
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_root_password
MYSQL_ROOT_PASSWORD=mysql_root_password
MYSQL_DATABASE=your_database_name
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password

# Названия баз для каждого сервиса (используются в init-скриптах)
USERS_DATABASE=tdn_users_test
CAMPAIGN_DATABASE=tdn_campaign_test

# URL'ы сервисов
USERS_SERVICE_URL=http://users-service:8080
CAMPAIGN_SERVICE_URL=http://campaign-service:8080

# Пути к ключам RSA
PUBLIC_KEY_PATH=/certs/public.pem

# Инфраструктура
ASPNETCORE_URLS=http://0.0.0.0:8080;http://0.0.0.0:8081

# Gateway
CORS_ENABLED=1
CORS_ORIGINS=*
OIDC_ISSUER=https://issuer.example.test

# Campaign
MONGO_SCHEMAS_DATABASE=tdn-schemas

# Settings/Users
MONGO_SETTINGS_DATABASE=tdn-settings
