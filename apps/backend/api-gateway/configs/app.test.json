{
  "logging": {
    "level": "INFO",
    "file": "/app/logs/gateway.log",
    "format": "%(asctime)s [%(levelname)s] [%(name)s] %(message)s",
    "rotation": {
      "type": "timed",
      "when": "midnight",
      "interval": 1,
      "backup_count": 7
    }
  },
  "routes": {
    "files": ["routes.yaml"]
  },
  "cors": {
    "allow_origins": ["*"],
    "allow_methods": ["*"],
    "allow_headers": ["*"],
    "allow_credentials": false
  },
  "request_id": {
    "header": "X-Request-ID",
    "generate_if_missing": true
  }
}
