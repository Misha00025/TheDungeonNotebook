{
  "name": "tdn-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@uiw/react-md-editor": "^4.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "start": "npm run dev --workspace @tdn/hub",
    "dev": "npm run dev --workspace @tdn/hub",
    "build": "npm run build --workspace @tdn/hub",
    "preview": "npm run preview --workspace @tdn/hub",
    "build:campaign": "npm run build --workspace @tdn/campaign",
    "build:game-systems": "npm run build --workspace @tdn/game-systems",
    "build:hub": "npm run build --workspace @tdn/hub",
    "build:profile": "npm run build --workspace @tdn/profile",
    "build:login": "npm run build --workspace @tdn/login",
    "test": "npm run test --workspace @tdn/campaign",
    "test:run": "npm run test:run --workspace @tdn/campaign"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
