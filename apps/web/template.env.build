# Параметры сборки (build.args) для docker compose.
# Скопируйте в .env.build:  cp template.env.build .env.build
# Затем разворачивайте:  docker compose --env-file .env.build up -d --build
#
# Базовые пути (VITE_BASE) — должны совпадать с путями reverse proxy.
VITE_BASE_HUB=/
VITE_BASE_CAMPAIGN=/campaign/
VITE_BASE_PROFILE=/profile/
VITE_BASE_LOGIN=/login/
# VITE_BASE_GAME_SYSTEMS=/game-systems/   # game-systems отключён

# URL remoteEntry.js каждого remote-приложения (использует только хаб).
VITE_REMOTE_CAMPAIGN=http://localhost:3000/assets/remoteEntry.js
VITE_REMOTE_PROFILE=http://localhost:3002/assets/remoteEntry.js
VITE_REMOTE_LOGIN=http://localhost:3003/assets/remoteEntry.js
