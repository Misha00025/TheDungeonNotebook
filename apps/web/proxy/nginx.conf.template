map $http_x_forwarded_proto $forwarded_proto {
    "" $scheme;
    default $http_x_forwarded_proto;
}

map $http_x_forwarded_host $forwarded_host {
    "" $http_host;
    default $http_x_forwarded_host;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    resolver @@RESOLVER@@;
    absolute_redirect off;
    proxy_redirect off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $forwarded_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Accept-Encoding "";
    set $hub_upstream @@HUB_UPSTREAM@@;
    set $campaign_upstream @@CAMPAIGN_UPSTREAM@@;
    set $profile_upstream @@PROFILE_UPSTREAM@@;
    set $login_upstream @@LOGIN_UPSTREAM@@;

    location = @@CONFIG_PATH@@ {
        alias /app/runtime/config.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

@@REMOTE_LOCATIONS@@

@@BASE_REDIRECT@@

    location ^~ @@BASE_PATH@@ {
        rewrite @@BASE_REWRITE@@ /$1 break;
        proxy_pass $hub_upstream;
        sub_filter @@BASE_HTML_OLD@@ @@BASE_HTML_NEW@@;
        sub_filter_once on;
    }

@@OUTSIDE_BASE@@
}
